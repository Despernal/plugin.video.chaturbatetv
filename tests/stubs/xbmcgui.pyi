"""Minimal type stubs for xbmcgui."""
from typing import Any, Iterable

NOTIFICATION_INFO: str
NOTIFICATION_WARNING: str
NOTIFICATION_ERROR: str


class ListItem:
    def __init__(self, label: str = ..., label2: str = ..., path: str = ...) -> None: ...
    def setLabel(self, label: str) -> None: ...
    def setLabel2(self, label: str) -> None: ...
    def setPath(self, path: str) -> None: ...
    def setArt(self, art: dict[str, str]) -> None: ...
    def setInfo(self, type: str, infoLabels: dict[str, Any]) -> None: ...
    def setProperty(self, key: str, value: str) -> None: ...
    def getProperty(self, key: str) -> str: ...
