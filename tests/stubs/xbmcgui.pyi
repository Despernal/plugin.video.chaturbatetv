    def setMimeType(self, mimetype: str) -> None: ...
    def setContentLookup(self, enable: bool) -> None: ...


class Window:
    def __init__(self, existingWindowId: int = ...) -> None: ...
    def getProperty(self, key: str) -> str: ...
    def setProperty(self, key: str, value: str) -> None: ...
    def clearProperty(self, key: str) -> None: ...
    def show(self) -> None: ...
    def close(self) -> None: ...
    def addControl(self, control: Any) -> None: ...
    def removeControl(self, control: Any) -> None: ...


class WindowDialog(Window):
    pass


