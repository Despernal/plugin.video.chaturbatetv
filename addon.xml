<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.chaturbatetv"
       name="Chaturbate TV"
       version="0.2.1"
       provider-name="flux">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="inputstream.adaptive" version="2.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Chaturbate browser with TV mode</summary>
        <description lang="en_GB">Standalone Chaturbate Kodi addon with priority-based TV mode, local favorites, and HLS playback through a localhost rewriting proxy.</description>
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
        <source>https:///flux/plugin.video.chaturbatetv</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
        <news>0.2.1 - Polish: full-bleed fanart, provider-name fix.
0.2.0 - Phase 2: browse menus (Top, New, Female, Male, Couple, Trans, Search), local favorites,  migration tool.</news>
    </extension>
</addon>
